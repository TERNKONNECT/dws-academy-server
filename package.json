{
  "name": "tekconnect-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nodemon --require dotenv/config server.js",
    "start": "node server.js",
    "db:sync": "node --require dotenv/config scripts/sync-db.js",
    "create-admin": "node --require dotenv/config scripts/create-admin.js",
    "create-super-admin": "node --require dotenv/config scripts/create-super-admin.js",
    "build": "echo 'No build step needed'",
    "test": "node --env-file=.env.test --experimental-test-module-mocks --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:local": "DATABASE_URL=postgres://postgres:postgres@localhost:5544/dws_academy_test npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify": "npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "supertest": "^7.2.2"
  }
}
